#include <stdlib.h>

struct Node* clone(struct Node* node, struct Node** map) {
    if (node == NULL)
        return NULL;

    if (map[node->val] != NULL)
        return map[node->val];

    struct Node* copy = malloc(sizeof(struct Node));
    copy->val = node->val;
    copy->numNeighbors = node->numNeighbors;
    copy->neighbors = malloc(copy->numNeighbors * sizeof(struct Node*));

    map[node->val] = copy;

    for (int i = 0; i < node->numNeighbors; i++) {
        copy->neighbors[i] = clone(node->neighbors[i], map);
    }

    return copy;
}

struct Node* cloneGraph(struct Node* s) {
    if (s == NULL)
        return NULL;

    struct Node* map[101] = {NULL};

    return clone(s, map);
}