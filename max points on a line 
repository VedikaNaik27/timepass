#include <stdlib.h>

typedef struct {
    long long dx, dy;
} Slope;

long long gcd(long long a, long long b) {
    while (b) {
        long long t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int compare(const void* a, const void* b) {
    Slope* x = (Slope*)a;
    Slope* y = (Slope*)b;

    if (x->dy != y->dy)
        return (x->dy > y->dy) - (x->dy < y->dy);

    return (x->dx > y->dx) - (x->dx < y->dx);
}

int maxPoints(int** points, int pointsSize, int* pointsColSize) {
    if (pointsSize <= 2) return pointsSize;

    int ans = 0;
    Slope* slopes = malloc(pointsSize * sizeof(Slope));

    for (int i = 0; i < pointsSize; i++) {
        int count = 0, duplicate = 1;

        for (int j = i + 1; j < pointsSize; j++) {
            long long dx = (long long)points[j][0] - points[i][0];
            long long dy = (long long)points[j][1] - points[i][1];

            if (dx == 0 && dy == 0) {
                duplicate++;
                continue;
            }

            long long g = gcd(llabs(dx), llabs(dy));
            dx /= g;
            dy /= g;

            if (dx < 0 || (dx == 0 && dy < 0)) {
                dx = -dx;
                dy = -dy;
            }

            slopes[count++] = (Slope){dx, dy};
        }

        qsort(slopes, count, sizeof(Slope), compare);

        int maxCount = 0, current = 0;

        for (int j = 0; j < count; j++) {
            if (j == 0 || compare(&slopes[j], &slopes[j - 1]) != 0)
                current = 1;
            else
                current++;

            if (current > maxCount)
                maxCount = current;
        }

        if (duplicate + maxCount > ans)
            ans = duplicate + maxCount;
    }

    free(slopes);
    return ans;
}