int* postorderTraversal(struct TreeNode* root, int* returnSize) {
    int* ans = malloc(100 * sizeof(int));
    struct TreeNode* stack[100];
    int top = -1, k = 0;

    if (root)
        stack[++top] = root;

    while (top >= 0) {
        struct TreeNode* curr = stack[top--];
        ans[k++] = curr->val;

        if (curr->left)
            stack[++top] = curr->left;

        if (curr->right)
            stack[++top] = curr->right;
    }

    for (int i = 0; i < k / 2; i++) {
        int temp = ans[i];
        ans[i] = ans[k - 1 - i];
        ans[k - 1 - i] = temp;
    }

    *returnSize = k;
    return ans;
}