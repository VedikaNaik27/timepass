typedef struct {
    int key, value;
    int prev, next;
    int used;
} Node;

typedef struct {
    Node *nodes;
    int capacity, size;
} LRUCache;

#define HEAD 10001
#define TAIL 10002

void removeNode(LRUCache* obj, int key) {
    int p = obj->nodes[key].prev;
    int n = obj->nodes[key].next;

    obj->nodes[p].next = n;
    obj->nodes[n].prev = p;
}

void addFront(LRUCache* obj, int key) {
    int first = obj->nodes[HEAD].next;

    obj->nodes[key].prev = HEAD;
    obj->nodes[key].next = first;

    obj->nodes[HEAD].next = key;
    obj->nodes[first].prev = key;
}

LRUCache* lRUCacheCreate(int capacity) {
    LRUCache* obj = malloc(sizeof(LRUCache));

    obj->nodes = calloc(10003, sizeof(Node));
    obj->capacity = capacity;
    obj->size = 0;

    obj->nodes[HEAD].next = TAIL;
    obj->nodes[TAIL].prev = HEAD;

    return obj;
}

int lRUCacheGet(LRUCache* obj, int key) {
    if (key < 0 || key > 10000 || !obj->nodes[key].used)
        return -1;

    removeNode(obj, key);
    addFront(obj, key);

    return obj->nodes[key].value;
}

void lRUCachePut(LRUCache* obj, int key, int value) {
    if (key < 0 || key > 10000 || obj->capacity == 0)
        return;

    if (obj->nodes[key].used) {
        obj->nodes[key].value = value;
        removeNode(obj, key);
        addFront(obj, key);
        return;
    }

    if (obj->size == obj->capacity) {
        int old = obj->nodes[TAIL].prev;
        removeNode(obj, old);
        obj->nodes[old].used = 0;
        obj->size--;
    }

    obj->nodes[key].key = key;
    obj->nodes[key].value = value;
    obj->nodes[key].used = 1;

    addFront(obj, key);
    obj->size++;
}

void lRUCacheFree(LRUCache* obj) {
    free(obj->nodes);
    free(obj);
}