#include <string.h>
#include <stdlib.h>

int minCut(char* s) {
    int n = strlen(s);
    bool dp[n][n];
    int cuts[n + 1];

    memset(dp, 0, sizeof(dp));

    for (int i = 0; i <= n; i++)
        cuts[i] = i - 1;

    for (int i = 0; i < n; i++) {
        for (int j = 0; j <= i; j++) {
            if (s[j] == s[i] && (i - j <= 1 || dp[j + 1][i - 1])) {
                dp[j][i] = true;
                if (cuts[i + 1] > cuts[j] + 1)
                    cuts[i + 1] = cuts[j] + 1;
            }
        }
    }

    return cuts[n];
}
