int* preorderTraversal(struct TreeNode* root, int* returnSize) {
    int* ans = malloc(100 * sizeof(int));
    struct TreeNode* stack[100];
    int top = -1, k = 0;

    if (root)
        stack[++top] = root;

    while (top >= 0) {
        struct TreeNode* curr = stack[top--];
        ans[k++] = curr->val;

        if (curr->right)
            stack[++top] = curr->right;

        if (curr->left)
            stack[++top] = curr->left;
    }

    *returnSize = k;
    return ans;
}